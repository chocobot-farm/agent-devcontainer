# The agent-desktop build context is the repository root; keep it small.
# Only ansible/, docker/, the catalog the build seeds into the image
# (.claude-plugin/ plus the plugin tree it publishes under .agents/), and
# py_packages/validate_agent_files/ (built into the image as a uv tool) are
# actually consumed by the build.
.git
.github
.claude
.codex
.devcontainer
.tmp
.venv
node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.tmp
# Editable-install metadata: stale by definition and confuses the wheel build.
**/*.egg-info
